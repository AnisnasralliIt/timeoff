# Copy to .env.local and fill in. .env.local is gitignored.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Google OAuth (optional). Leave empty to hide the Google button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

DATABASE_URL="postgresql://timeoff:timeoff@localhost:5433/timeoff?schema=public"

# S3-compatible attachments (medical certificates). MinIO in dev via docker-compose.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="timeoff"
S3_SECRET_ACCESS_KEY="timeoff-minio-pw"
S3_BUCKET="timeoff-attachments"

# AES-256-GCM key (64 hex chars = 32 bytes) for attachment blobs + feed tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# HMAC secret for signed attachment download URLs (64 hex chars).
SIGNING_SECRET=""

# Stage 6: background jobs (A5) + transactional email (I3). The BullMQ worker
# reads these too (it loads this file when DATABASE_URL is not already set).
REDIS_URL="redis://localhost:6379"

# Optional. When unset the worker runs in dev mode: outbox rows are marked SENT
# with a note instead of being delivered, so the pipeline is verifiable without
# a real provider.
RESEND_API_KEY=""
EMAIL_FROM="TimeOff <no-reply@timeoff.local>"
EMAIL_REPLY_TO=""
COMPANY_TZ="Europe/Berlin"

# Audit-log retention (G3): default 3 years. The nightly purge job deletes
# AuditLog rows older than this and EmailMessage rows older than the 90-day cap.
AUDIT_RETENTION_DAYS="1095"
EMAIL_MESSAGE_RETENTION_DAYS="90"
